{
  "expo": {
    "name": "Accountability",
    "slug": "mnp-accountability",
    "scheme": "mnp-accountability",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mnp.accountability"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "root": "app"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
